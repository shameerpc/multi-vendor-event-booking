# ═══════════════════════════════════════════════════════════════════
# EventHub backend environment variables
#
# Local development:       copy to .env and edit
# Render (production):    set these in Render > Environment (never in the repo)
# ═══════════════════════════════════════════════════════════════════

# MongoDB Atlas connection string (mongodb+srv://). TLS is automatic with the
# +srv scheme. Always use a Database URL with credentials created for the app.
#   Local example: mongodb://127.0.0.1:27017/event_ticket_booking
#   Atlas example: mongodb+srv://<dbUser>:<dbPassword>@cluster.mongodb.net/<dbName>?retryWrites=true&w=majority
# NEVER commit real credentials; Render injects these at runtime.
MONGO_URI=mongodb://127.0.0.1:27017/event_ticket_booking

# Render sets PORT automatically. Leave it unset for local dev (default 5000).
# PORT=5000

# JWT signing secret - generate a long, random string (min 32 chars).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_random_secret_at_least_32_chars_long

# How long a JWT stays valid (7d, 12h, 30m, ...)
JWT_EXPIRES_IN=7d

# Allowed browser origin(s), comma-separated. In production restrict to the
# deployed Netlify frontend ONLY, e.g.:
#   CORS_ORIGIN=https://eventhub.netlify.app
# Multiple: https://a.netlify.app,https://preview--a.netlify.app
# Use http://localhost:5173 for the local Vite dev server.
CORS_ORIGIN=http://localhost:5173