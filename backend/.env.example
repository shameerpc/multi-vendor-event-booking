# MongoDB connection string
# Use a local instance or MongoDB Atlas. NEVER commit real credentials.
MONGO_URI=mongodb://127.0.0.1:27017/event_ticket_booking

# Server port
PORT=5000

# JWT signing secret - generate a long, random string (min 32 chars).
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_random_secret_at_least_32_chars_long

# How long a JWT stays valid (JSON duration, e.g. 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
# Use http://localhost:5173 for the local Vite dev server.
CORS_ORIGIN=http://localhost:5173